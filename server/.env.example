# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
DB_NAME=maindb
DB_USER=postgres
DB_PASSWORD=
HOST=localhost
DIALECT=postgres

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File uploads (AWS S3 presigned POST)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=

# Email (AWS SES verified sender address, used for password-reset links)
EMAIL_SENDER=
